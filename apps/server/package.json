{
  "name": "@ai-workflow/server",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "runtime:prepare": "pnpm --filter @ai-workflow/core build:node && pnpm --filter @ai-workflow/protocol build:node && pnpm --filter @ai-workflow/runtime build:node && pnpm --filter @ai-workflow/plugin build:node",
    "predev": "pnpm run runtime:prepare",
    "dev": "nest start --watch",
    "predev:server": "pnpm run runtime:prepare",
    "dev:server": "nest start --watch",
    "build": "pnpm run runtime:prepare && pnpm run prisma:generate && nest build",
    "prestart": "pnpm run runtime:prepare",
    "start": "nest start",
    "prestart:dev": "pnpm run runtime:prepare",
    "start:dev": "nest start --watch",
    "prestart:debug": "pnpm run runtime:prepare",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:prod:migrate": "pnpm run prisma:migrate:deploy && pnpm run start:prod",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier . --write --config ../../configs/prettier/.prettierrc.json --ignore-path ../../configs/prettier/.prettierignore",
    "format:check": "prettier . --check --config ../../configs/prettier/.prettierrc.json --ignore-path ../../configs/prettier/.prettierignore",
    "check": "pnpm run format:check && pnpm run lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@ai-workflow/core": "workspace:*",
    "@ai-workflow/plugin": "workspace:*",
    "@ai-workflow/protocol": "workspace:*",
    "@ai-workflow/runtime": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "amqplib": "^2.0.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "joi": "^18.2.3",
    "nest-winston": "^1.10.2",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "dotenv": "^17.4.2",
    "jest": "^30.0.0",
    "prisma": "7.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
