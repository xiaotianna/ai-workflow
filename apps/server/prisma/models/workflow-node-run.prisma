// 在某一次 WorkflowRun 中，某个节点的一次具体执行
model WorkflowNodeRun {
  id               String                @id @default(uuid()) @db.Uuid
  runId            String                @db.Uuid // 表示这条节点运行属于哪一次完整工作流运行
  nodeId           String
  nodeType         String // 节点类型
  executionKey     String // 表示这个节点在本次运行中的哪一次逻辑执行，普通节点和nodeId一致，针对于循环、分支节点，存储：loop-1/[nodeId]
  attempt          Int                   @default(1) // 尝试次数
  commandId        String                @unique @db.Uuid
  idempotencyKey   String                @unique
  leaseToken       String
  deadlineAt       DateTime
  hardDeadlineAt   DateTime
  progressSequence Int                   @default(0)
  status           WorkflowNodeRunStatus @default(PENDING) // 节点执行状态
  input            Json?                 @db.JsonB // 节点的输入数据
  output           Json?                 @db.JsonB // 节点的输出数据
  errorCode        String?
  errorMessage     String?
  errorDetails     Json?                 @db.JsonB
  startedAt        DateTime? // 节点进入执行链路的时间
  finishedAt       DateTime?
  durationMs       Int? // 从进入执行链路到终态的时间
  createdAt        DateTime              @default(now())

  run           WorkflowRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  commandOutbox WorkflowCommandOutbox?
  resultInbox   WorkflowResultInbox?
  childRun      WorkflowRun?           @relation("WorkflowRunParentNode")

  @@unique([runId, executionKey, attempt])
  @@index([runId, createdAt])
  @@index([nodeId])
  @@index([status, deadlineAt])
  @@map("workflow_node_runs")
}
