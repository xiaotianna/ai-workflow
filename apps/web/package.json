{
  "name": "@ai-workflow/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier . --write --config ../../configs/prettier/.prettierrc.json --ignore-path ../../configs/prettier/.prettierignore",
    "format:check": "prettier . --check --config ../../configs/prettier/.prettierrc.json --ignore-path ../../configs/prettier/.prettierignore",
    "check": "pnpm run format:check && pnpm run lint"
  },
  "dependencies": {
    "@ai-workflow/core": "workspace:*",
    "@ai-workflow/form": "workspace:*",
    "@ai-workflow/nodes-ui": "workspace:*",
    "@ai-workflow/shared": "workspace:*",
    "@ai-workflow/ui": "workspace:*",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "motion": "^12.42.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  }
}
