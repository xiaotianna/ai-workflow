# 默认只允许宿主机本地访问，由 Nginx/Caddy/OpenResty 反代；需要直接公开时改成 8080。
APP_PORT=127.0.0.1:8080

# Web、Server、Executor、Agent Runtime 共用的应用镜像名称。
APP_IMAGE=ai-workflow-app:latest

# Go 镜像构建代理；默认已使用国内镜像，网络允许时可改为 https://proxy.golang.org,direct。
GOPROXY=https://goproxy.cn,direct

POSTGRES_DB=ai_workflow
POSTGRES_USER=ai_workflow
# 留空时首次启动自动生成。手动覆盖时使用 URL-safe 字符。
POSTGRES_PASSWORD=

RABBITMQ_USER=ai_workflow
RABBITMQ_VHOST=ai_workflow
# 留空时首次启动自动生成。手动覆盖时使用 URL-safe 字符。
RABBITMQ_PASSWORD=

# 留空时首次启动自动生成。手动覆盖时需同时包含大小写字母、数字和特殊字符。
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# 内部认证密钥留空时会在首次启动自动生成。
JWT_SECRET=
EXECUTOR_INTERNAL_AUTH_TOKEN=
AGENT_RUNTIME_INTERNAL_AUTH_TOKEN=

AGENT_RUN_TIMEOUT_MS=180000

# 手动覆盖时必须是 32 字节 Base64。
MODEL_CREDENTIAL_ENCRYPTION_KEY=
