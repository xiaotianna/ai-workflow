# 对外访问端口。前面已有 Nginx/Caddy 时可以改成 127.0.0.1:8080。
APP_PORT=80

POSTGRES_DB=ai_workflow
POSTGRES_USER=ai_workflow
# 留空时首次启动自动生成。手动覆盖时使用 URL-safe 字符。
POSTGRES_PASSWORD=

RABBITMQ_USER=ai_workflow
RABBITMQ_VHOST=ai_workflow
# 留空时首次启动自动生成。手动覆盖时使用 URL-safe 字符。
RABBITMQ_PASSWORD=

# 留空时首次启动自动生成。手动覆盖时需同时包含大小写字母、数字和特殊字符。
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# 下面三个值留空时也会首次启动自动生成。
JWT_SECRET=
EXECUTOR_INTERNAL_AUTH_TOKEN=

# 手动覆盖时必须是 32 字节 Base64。
MODEL_CREDENTIAL_ENCRYPTION_KEY=
