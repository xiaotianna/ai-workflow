{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:web": {
      "cache": false,
      "persistent": true
    },
    "dev:server": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["AGENT_*", "NODE_ENV"]
    },
    "dev:agent": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["AGENT_*", "AI_WORKFLOW_SERVER_URL", "PORT", "NODE_ENV"]
    },
    "@ai-workflow/agent-runtime#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["AGENT_*", "AI_WORKFLOW_SERVER_URL", "PORT", "NODE_ENV"]
    },
    "@ai-workflow/server#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["AGENT_*", "NODE_ENV"]
    }
  }
}
