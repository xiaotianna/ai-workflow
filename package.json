{
  "name": "ai-workflow",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "author": "",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev:web --filter=@ai-workflow/web",
    "dev:server": "turbo dev:server --filter=@ai-workflow/server",
    "plugin:cli:build": "pnpm --filter @ai-workflow/plugin-cli build",
    "plugin:init": "pnpm run plugin:cli:build && node ./packages/workflow-plugin-cli/bin/ai-workflow-plugin.mjs init --local",
    "build": "turbo run build",
    "docker:dev:up": "docker compose -f compose.dev.yaml up -d",
    "docker:dev:down": "docker compose -f compose.dev.yaml down",
    "docker:dev:logs": "docker compose -f compose.dev.yaml logs -f",
    "docker:dev:status": "docker compose -f compose.dev.yaml ps",
    "lint": "oxlint .",
    "lint:staged": "oxlint . --fix",
    "format:staged": "prettier --write --config ./configs/prettier/.prettierrc.json --ignore-path ./configs/prettier/.prettierignore",
    "format:check": "prettier . --check --config ./configs/prettier/.prettierrc.json --ignore-path ./configs/prettier/.prettierignore",
    "check": "pnpm format:check && pnpm lint",
    "husky:init": "npx husky init",
    "prepare": "husky && pnpm run plugin:cli:build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "pnpm lint:staged",
      "pnpm format:staged"
    ],
    "*.{json,css,scss,md,mdx}": "pnpm format:staged"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-vinyl"
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@oxlint/binding-darwin-arm64": "1.62.0",
    "@rolldown/binding-darwin-arm64": "1.0.0-rc.17",
    "@tailwindcss/vite": "^4.2.4",
    "commitizen": "^4.3.1",
    "commitlint": "^20.5.2",
    "cz-vinyl": "^1.6.2",
    "esbuild": "^0.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.62.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.2.4",
    "turbo": "^2.10.5"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^11.1.15",
    "lucide-react": "^1.14.0",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  }
}
