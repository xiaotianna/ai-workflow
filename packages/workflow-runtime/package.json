{
  "name": "@ai-workflow/runtime",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:node": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --sourcemap --outfile=dist/index.cjs"
  },
  "dependencies": {
    "@ai-workflow/core": "workspace:*",
    "@ai-workflow/protocol": "workspace:*",
    "zod": "^4.4.3"
  }
}
