{
  "name": "@ai-workflow/plugin",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./src/index.ts"
    },
    "./ui": "./src/ui/index.ts",
    "./executor": "./src/executor/index.ts"
  },
  "scripts": {
    "build:node": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --sourcemap --outfile=dist/index.cjs"
  },
  "dependencies": {
    "@ai-workflow/core": "workspace:*",
    "@ai-workflow/form": "workspace:*",
    "@ai-workflow/nodes-ui": "workspace:*",
    "@ai-workflow/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  }
}
